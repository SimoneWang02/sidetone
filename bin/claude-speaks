#!/usr/bin/env bash
# claude-speaks: control the voice hub from a terminal.
set -u
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../hooks/lib.sh"

usage() {
  cat <<'EOF'
Usage: claude-speaks <command>

  status                     sessions the hub knows, and what is queued
  say [-v VOICE] TEXT        speak a line through the hub
  voices                     every voice you can choose, and which project has which
  voice PROJECT VOICE        give a project a voice (applies at once)
  voice add NAME FILE        add your own Kokoro voice file (.npy)
  voice mix NAME VOICE=WEIGHT VOICE=WEIGHT...   make a new voice by blending existing ones
  voice remove NAME          delete one of your own voices
  stop                       stop speaking and clear the queue
  on | off                   turn the voice on or off for every session
  allow | deny               answer the permission prompt the overlay is showing
  answer N                   pick option N of the question the overlay is showing
  sound sent|queued|failed   play one of the short sounds that answer push-to-talk
  repeat                     say the last line again
  missed                     replay what sessions said since you were last here
  follow-up [-s PROJECT] TEXT   send a follow-up to a session as if you had said it
  talk start|stop|cancel     the talk key and the cancel key, from a shell
  target [PROJECT]           show or choose which session a spoken follow-up goes to
  overlay dots|list|toggle|restart   switch the on-screen overlay's view, or restart it
  overlay layout NAME|next   how sessions are shown: bar or island
  overlay move               make the overlay easy to find and drag (you can drag it any time)
  overlay monitor N          put it on monitor N (0 = primary)
  overlay corner top-right|top-left|bottom-right|bottom-left
  demo                       play three made-up sessions to see and hear every state
  hub start|stop|restart     manage the background hub
  log                        follow the speech log
EOF
}

hub_get() { [ -S "$CS_SOCK" ] && curl -sf -m 2 --unix-socket "$CS_SOCK" "http://hub$1"; }

hub_wait() {  # wait until the hub answers, up to 10 s
  for _ in $(seq 100); do hub_get /health >/dev/null 2>&1 && return 0; sleep 0.1; done
  echo "hub did not start; see $CS_STATE/hub.log" >&2; return 1
}

hub_stop() {
  hub_post /shutdown </dev/null >/dev/null 2>&1 || return 0
  for _ in $(seq 50); do [ -S "$CS_SOCK" ] || return 0; sleep 0.1; done
}

case ${1:-} in
  status)
    state=$(hub_get /state) || { echo "hub is not running"; exit 1; }
    jq -r 'if .muted then "voice: off" else "voice: on" end' <<<"$state"
    jq -r 'if (.sessions | length) == 0 then "no sessions" else
        (.sessions[] | [.name, .state, (.activity | if . == "" then "-" else . end),
          (if .tasks_total > 0 then "\(.tasks_done)/\(.tasks_total)" else "-" end), .voice] | @tsv) end' <<<"$state" |
      column -t -s $'\t'
    jq -r '.queued[] | "queued: [\(.kind)] \(.text)"' <<<"$state"
    ;;
  say)
    shift; voice=
    [ "${1:-}" = -v ] && { voice=$2; shift 2; }
    [ $# -gt 0 ] || { usage; exit 2; }
    hub_get /health >/dev/null 2>&1 || { hub_start && hub_wait || exit 1; }
    jq -nc --arg text "$*" --arg voice "$voice" '{text: $text} + (if $voice == "" then {} else {voice: $voice} end)' |
      hub_post /say >/dev/null
    ;;
  voices)
    v=$(hub_get /voices) || { echo "hub is not running"; exit 1; }
    [ "$(jq -r .choosable <<<"$v")" = true ] || { echo "This machine's voice engine has one voice for everything."; exit 0; }
    echo "Projects:"; jq -r '.projects | to_entries[] | "  \(.key)\t\(.value)"' <<<"$v" | column -t -s $'\t' | sed 's/^/  /'
    echo "Given to new projects:"; jq -r '"  " + (.pool | join(" "))' <<<"$v"
    echo "All built-in voices:"; jq -r '.builtin | join(" ")' <<<"$v" | fold -s -w 96 | sed 's/^/  /'
    echo "Your own voices:"; jq -r '"  " + (if (.custom | length) > 0 then (.custom | join(" ")) else "(none yet; see: voice add, voice mix)" end)' <<<"$v"
    echo "Hear one:  claude-speaks say -v VOICE \"Hello, this is how I sound.\""
    ;;
  voice)
    case ${2:-} in
      add)
        [ $# -eq 4 ] && [ -f "$4" ] || { echo "usage: claude-speaks voice add NAME FILE"; exit 2; }
        request=$(jq -nc --arg n "$3" --arg p "$(readlink -f "$4")" '{action: "add", name: $n, path: $p}') ;;
      mix)
        [ $# -ge 5 ] || { echo "usage: claude-speaks voice mix NAME VOICE=WEIGHT VOICE=WEIGHT..."; exit 2; }
        name=$3; shift 3
        request=$(printf '%s\n' "$@" | jq -Rnc --arg n "$name" '{action: "add", name: $n, mix: ([inputs | split("=") | {(.[0]): (.[1] // "1" | tonumber)}] | add)}') ||
          { echo "weights must be numbers, like af_heart=0.6"; exit 2; } ;;
      remove)
        [ $# -eq 3 ] || { echo "usage: claude-speaks voice remove NAME"; exit 2; }
        request=$(jq -nc --arg n "$3" '{action: "remove", name: $n}') ;;
      *)
        [ $# -eq 3 ] || { usage; exit 2; }
        request=$(jq -nc --arg p "$2" --arg v "$3" '{action: "set", project: $p, voice: $v}') ;;
    esac
    reply=$(hub_post /voice 5 <<<"$request") || { echo "hub is not running"; exit 1; }
    error=$(jq -r '.error // empty' <<<"$reply")
    [ -z "$error" ] && echo "done" || { echo "$error"; exit 1; }
    ;;
  stop) hub_post /stop </dev/null >/dev/null || { echo "hub is not running"; exit 1; } ;;
  on) rm -f "$HOME/.claude/voice-off"; echo "voice on" ;;
  off) mkdir -p "$HOME/.claude" && touch "$HOME/.claude/voice-off"; hub_post /stop </dev/null >/dev/null 2>&1; echo "voice off" ;;
  allow|deny)
    answered=$(jq -nc --arg d "$1" '{decision: $d}' | hub_post /decide | jq -r .answered)
    [ "$answered" = true ] && echo "$1 sent" || { echo "no permission prompt is waiting"; exit 1; }
    ;;
  follow-up)
    shift; project=
    [ "${1:-}" = -s ] && { project=$2; shift 2; }
    [ $# -gt 0 ] || { usage; exit 2; }
    queued=$(jq -nc --arg t "$*" --arg p "$project" '{text: $t} + (if $p == "" then {} else {session: $p} end)' |
      hub_post /follow-up | jq -r .queued)
    [ "$queued" = true ] && echo "queued" || { echo "no such session"; exit 1; }
    ;;
  target)
    reply=$(jq -nc --arg p "${2:-}" 'if $p == "" then {} else {session: $p} end' | hub_post /target) ||
      { echo "hub is not running"; exit 1; }
    [ "$(jq -r .found <<<"$reply")" = true ] || { echo "no such session: ${2:-}"; exit 1; }
    echo "follow-ups go to: $(jq -r '.target // "nobody (no sessions)"' <<<"$reply")"
    ;;
  talk)
    case ${2:-} in
      start|stop|cancel) jq -nc --arg a "$2" '{action: $a}' | hub_post /talk >/dev/null || { echo "hub is not running"; exit 1; } ;;
      *) usage; exit 2 ;;
    esac
    ;;
  answer)
    answered=$(jq -nc --arg n "${2:-0}" '{option: ($n | tonumber? // 0)}' | hub_post /answer | jq -r .answered)
    [ "$answered" = true ] && echo "answered" || { echo "no question is waiting, or it has no option ${2:-}"; exit 1; }
    ;;
  sound)
    played=$(jq -nc --arg n "${2:-sent}" '{name: $n}' | hub_post /sound | jq -r .played) || { echo "hub is not running"; exit 1; }
    [ "$played" = true ] || { echo "no such sound, or sounds cannot be played here: ${2:-sent}"; exit 1; }
    ;;
  repeat) echo '{"what": "last"}' | hub_post /replay >/dev/null || { echo "hub is not running"; exit 1; } ;;
  missed)
    count=$(echo '{"what": "missed"}' | hub_post /replay | jq -r .count) || { echo "hub is not running"; exit 1; }
    echo "$count missed"
    ;;
  overlay)
    case ${2:-toggle} in
      dots|list|toggle) jq -nc --arg m "${2:-toggle}" '{mode: $m}' | hub_post /overlay >/dev/null ;;
      restart) echo '{"restart": true}' | hub_post /overlay >/dev/null ;;
      move) echo '{"move": true}' | hub_post /overlay >/dev/null && echo "drag the overlay now; it stays where you drop it" ;;
      monitor) jq -nc --arg n "${3:-0}" '{monitor: ($n | tonumber)}' | hub_post /overlay >/dev/null ;;
      layout)
        got=$(jq -nc --arg l "${3:-next}" '{layout: $l}' | hub_post /overlay | jq -r '.layout // empty')
        [ -n "$got" ] && echo "layout: $got" || { echo "layouts: bar, island (or: next)"; exit 2; } ;;
      corner)
        case ${3:-} in top-right|top-left|bottom-right|bottom-left) ;; *) usage; exit 2 ;; esac
        jq -nc --arg c "$3" '{corner: $c}' | hub_post /overlay >/dev/null ;;
      *) usage; exit 2 ;;
    esac || { echo "no overlay (hub not running, or not on Windows/WSL)"; exit 1; }
    ;;
  demo)
    hub_get /health >/dev/null 2>&1 || { hub_start && hub_wait || exit 1; }
    hub_post /demo </dev/null >/dev/null || { echo "the hub did not answer; see $CS_STATE/hub.log" >&2; exit 1; }
    cat <<'EOF'
Demo: three made-up sessions for about 40 seconds.
  Look    a glass bar with three status lights (top right of your main screen unless you moved it).
          Rest the mouse on it and it opens to show each session's name and title.
  Listen  the first voice comes after about 8 seconds, then three more. Each line shows in a
          bubble next to the bar, with a wave that follows the voice.
  Try     Ctrl+Alt+L keeps the bar open; press it again to close it.
EOF
    ;;
  hub)
    case ${2:-} in
      start) hub_start && hub_wait && echo "hub running" ;;
      stop) hub_stop; echo "hub stopped" ;;
      restart) hub_stop; hub_start && hub_wait && echo "hub running" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  log) mkdir -p "$CS_STATE"; touch "$CS_STATE/voice.log"; exec tail -n 20 -f "$CS_STATE/voice.log" ;;
  *) usage; [ $# -eq 0 ] || exit 2 ;;
esac
