{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh --start",
            "async": true
          },
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/listen.sh",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/voice-reminder.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh --start",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/permission.sh",
            "timeout": 3600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh",
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/speak.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/listen.sh",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/report.sh",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/personal/claude-speaks/hooks/display.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
